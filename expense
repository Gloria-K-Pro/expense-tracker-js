<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="A JavaScript expense tracker assignment demonstrating variables, conditionals, arrays, loops and budget checking.">

    <title>Expense Tracker | JavaScript Assignment</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="styles.css">
</head>

<body>

    <!-- =========================
         HEADER
    ========================== -->

    <header class="header">

        <div class="header-container">

            <div class="logo">
                <span class="logo-icon">💰</span>
                <span>ExpenseTracker</span>
            </div>

            <span class="assignment-label">
                JavaScript Assignment
            </span>

        </div>

    </header>


    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <main class="main-container">

        <!-- Hero Section -->

        <section class="hero">

            <div class="hero-content">

                <span class="badge">
                    WEEKLY ASSIGNMENT
                </span>

                <h1>
                    Expense Tracker
                </h1>

                <p>
                    A simple JavaScript project demonstrating
                    variables, conditional statements, arrays,
                    loops, and budget checking.
                </p>

                <div class="console-message">
                    <span class="console-icon">⌨</span>

                    <span>
                        Open your browser console to view the
                        JavaScript results.
                    </span>
                </div>

            </div>

        </section>


        <!-- =========================
             EXPENSE CARDS
        ========================== -->

        <section class="section">

            <div class="section-heading">

                <div>
                    <span class="section-label">
                        PART 1
                    </span>

                    <h2>
                        Sample Expenses
                    </h2>
                </div>

                <p>
                    Six sample monthly expenses
                </p>

            </div>


            <div class="expense-grid">

                <!-- Rent -->

                <article class="expense-card">

                    <div class="expense-icon rent-icon">
                        🏠
                    </div>

                    <div class="expense-info">

                        <span>
                            Rent
                        </span>

                        <strong>
                            $250
                        </strong>

                    </div>

                </article>


                <!-- Food -->

                <article class="expense-card">

                    <div class="expense-icon food-icon">
                        🍔
                    </div>

                    <div class="expense-info">

                        <span>
                            Food
                        </span>

                        <strong>
                            $80
                        </strong>

                    </div>

                </article>


                <!-- Transport -->

                <article class="expense-card">

                    <div class="expense-icon transport-icon">
                        🚗
                    </div>

                    <div class="expense-info">

                        <span>
                            Transport
                        </span>

                        <strong>
                            $60
                        </strong>

                    </div>

                </article>


                <!-- Internet -->

                <article class="expense-card">

                    <div class="expense-icon internet-icon">
                        🌐
                    </div>

                    <div class="expense-info">

                        <span>
                            Internet
                        </span>

                        <strong>
                            $120
                        </strong>

                    </div>

                </article>


                <!-- Entertainment -->

                <article class="expense-card">

                    <div class="expense-icon entertainment-icon">
                        🎬
                    </div>

                    <div class="expense-info">

                        <span>
                            Entertainment
                        </span>

                        <strong>
                            $75
                        </strong>

                    </div>

                </article>


                <!-- Utilities -->

                <article class="expense-card">

                    <div class="expense-icon utilities-icon">
                        💡
                    </div>

                    <div class="expense-info">

                        <span>
                            Utilities
                        </span>

                        <strong>
                            $90
                        </strong>

                    </div>

                </article>

            </div>

        </section>


        <!-- =========================
             ASSIGNMENT FEATURES
        ========================== -->

        <section class="features-section">

            <div class="section-heading">

                <div>

                    <span class="section-label">
                        PARTS 2–4
                    </span>

                    <h2>
                        JavaScript Features
                    </h2>

                </div>

            </div>


            <div class="feature-grid">

                <article class="feature-card">

                    <div class="feature-number">
                        01
                    </div>

                    <h3>
                        High Spending Check
                    </h3>

                    <p>
                        Each expense is checked individually.
                        Expenses above $100 are classified as
                        High Spending.
                    </p>

                </article>


                <article class="feature-card">

                    <div class="feature-number">
                        02
                    </div>

                    <h3>
                        Total Expenses
                    </h3>

                    <p>
                        All six expenses are stored in an array
                        and calculated using a for...of loop.
                    </p>

                </article>


                <article class="feature-card">

                    <div class="feature-number">
                        03
                    </div>

                    <h3>
                        Budget Check
                    </h3>

                    <p>
                        Total expenses are compared with the
                        monthly income to determine the budget status.
                    </p>

                </article>

            </div>

        </section>


        <!-- =========================
             BUDGET SUMMARY
        ========================== -->

        <section class="budget-section">

            <div class="budget-card">

                <div class="budget-header">

                    <div>

                        <span class="section-label">
                            BUDGET OVERVIEW
                        </span>

                        <h2>
                            Monthly Budget
                        </h2>

                    </div>

                    <div class="status-badge">
                        Within Budget
                    </div>

                </div>


                <div class="budget-values">

                    <div class="budget-item">

                        <span>
                            Monthly Income
                        </span>

                        <strong>
                            $800
                        </strong>

                    </div>


                    <div class="divider"></div>


                    <div class="budget-item">

                        <span>
                            Total Expenses
                        </span>

                        <strong>
                            $675
                        </strong>

                    </div>


                    <div class="divider"></div>


                    <div class="budget-item remaining">

                        <span>
                            Remaining
                        </span>

                        <strong>
                            $125
                        </strong>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             CONSOLE INSTRUCTIONS
        ========================== -->

        <section class="instructions">

            <div class="terminal">

                <div class="terminal-header">

                    <div class="terminal-dots">

                        <span></span>
                        <span></span>
                        <span></span>

                    </div>

                    <span>
                        Browser Console
                    </span>

                </div>


                <div class="terminal-body">

                    <p>
                        <span class="terminal-symbol">
                            $
                        </span>

                        Open Developer Tools
                    </p>

                    <p>
                        <span class="terminal-symbol">
                            $
                        </span>

                        Select the Console tab
                    </p>

                    <p>
                        <span class="terminal-symbol">
                            $
                        </span>

                        View the JavaScript output
                    </p>

                </div>

            </div>

        </section>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="footer">

        <p>
            Expense Tracker &copy; 2026
        </p>

        <p>
            JavaScript Assignment
        </p>

    </footer>


    <!-- JavaScript -->
    <script src="script.js"></script>

</body>

</html>
